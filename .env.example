APP_NAME=AIVisionRadar
DATABASE_URL=sqlite:///./data/aivisionradar.db
ENABLE_SCHEDULER=false

# Cloudflare Tunnel Token (Synology 部署时使用，见 docs/deploy-synology.md)
CLOUDFLARE_TUNNEL_TOKEN=

# GitHub token for GitHub Search API (optional)
GITHUB_TOKEN=

# AI summary (optional - system works without this)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Scheduler settings
CRAWL_INTERVAL_HOURS=6
DAILY_REPORT_HOUR=8
