APP_NAME=AIVisionRadar
DATABASE_URL=sqlite:///./data/aivisionradar.db
ENABLE_SCHEDULER=false

# Cloudflare Tunnel Token (Synology 部署时使用，见 docs/deploy-synology.md)
CLOUDFLARE_TUNNEL_TOKEN=

# GitHub token for GitHub Search API (optional)
GITHUB_TOKEN=

# AI summary + translation (optional - system works without this)
# Compatible with OpenAI / DeepSeek / Qwen / any OpenAI-compatible API
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Translation: enable in Settings page UI after starting the app
# ENABLE_TRANSLATION=false  ← now controlled in web UI /settings

# Scheduler settings
CRAWL_INTERVAL_HOURS=6
DAILY_REPORT_HOUR=8
